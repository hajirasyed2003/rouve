# ROUVÉ frontend environment. Copy to .env.local. NEVER commit .env.local.
# Only NEXT_PUBLIC_* values reach the browser: put nothing secret here.

# Base URL of the FastAPI backend, including the version prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Public site URL (canonical links, Open Graph). Set to the real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Reserved for later milestones (not read by any code yet) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me        # the public anon key only, never the service role key
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_replace_me # public key id only; the secret stays on the backend
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=replace-me
