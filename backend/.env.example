# ROUVÉ backend environment. Copy to .env and fill in. NEVER commit .env.
# All values below are placeholders.

# --- Application ---
APP_ENV=development            # development | test | staging | production
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
# Comma-separated, explicit origins only ("*" is rejected).
CORS_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL on Supabase) ---
# Supabase dashboard > Connect. Use the DIRECT connection (port 5432) for Alembic migrations.
# "postgresql://" is converted to the asyncpg driver automatically. Supabase requires SSL: add ?ssl=require
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?ssl=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# Set true only when DATABASE_URL points at the transaction pooler (PgBouncer, port 6543).
DB_USE_PGBOUNCER=false

# --- Reserved for later milestones (read into settings but NOT used yet) ---
# Supabase Auth
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me       # server-side only; never expose to the browser
SUPABASE_JWT_SECRET=replace-me             # used to verify Supabase access tokens
JWT_ALGORITHM=HS256

# Cloudinary
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me

# Razorpay (use test keys until launch)
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-me
RAZORPAY_WEBHOOK_SECRET=replace-me

# Shiprocket
SHIPROCKET_EMAIL=replace-me@example.com
SHIPROCKET_PASSWORD=replace-me
